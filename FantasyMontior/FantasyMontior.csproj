<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <!-- WPF owns process DPI through app.manifest; WinForms is used only for NotifyIcon/Screen. -->
        <NoWarn>$(NoWarn);WFO0003</NoWarn>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources/Strings.json" />
        <Resource Include="Resources/Icons/*.svg" />
        <Using Remove="System.Windows.Forms" />
        <Using Remove="System.Drawing" />
        <ProjectReference Include="../FantasyMontior.Core/FantasyMontior.Core.csproj" />
    </ItemGroup>

</Project>
